{

  "manifest_version": 2,
  "name": "No YouTube Premieres",
  "version": "1.5.3",

  "description": "Hides Premieres from the YouTube subscription page.",

  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": { "required": ["none"] }
    }
  },

  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["no_premieres.js"]
    }
  ]

}
